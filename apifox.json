{
  "openapi": "3.0.3",
  "info": {
    "title": "实验室招新系统 - 完整接口文档 v2.0",
    "description": "基于 Django + django-ninja 的管理员后台完整接口。\n\n## 🔐 认证方式\n- `Authorization: Bearer <access_token>`\n\n## 🔑 测试账号\n| 角色 | 账号 | 密码 |\n|------|------|------|\n| 超管 | admin | admin123 |\n| 普通学员 | 2024001 | test123456 |",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "本地开发服务器"
    }
  ],
  "paths": {
    "/api/user/login": {
      "post": {
        "tags": ["🔐 认证管理"],
        "summary": "用户登录",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginInput" },
              "example": { "account": "admin", "password": "admin123", "remember_me": false }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "登录成功",
                  "data": {
                    "user_id": 5,
                    "account": "admin",
                    "username": "超级管理员",
                    "role": 2,
                    "token": "eyJhbGciOiJIUzI1NiJ9.eyJ1c2VyX2lkIjo1LCJyb2xlIjoyLCJhY2NvdW50IjoiYWRtaW4iLCJ0b2tlbl90eXBlIjoiYWNjZXNzIiwianRpIjoiYWNjXzVfMTc3OTk2OTU1NSIsImlhdCI6MTc3OTk2OTU1NSwiZXhwIjoxNzgwMDU1OTU1fQ.example",
                    "refresh_token": "eyJhbGciOiJIUzI1NiJ9.eyJ1c2VyX2lkIjo1LCJ0b2tlbl90eXBlIjoicmVmcmVzaCIsImp0aSI6InJlZl81XzE3Nzk5Njk1NTUiLCJpYXQiOjE3Nzk5Njk1NTUsImV4cCI6MTc4MDU3NDM1NX0.example"
                  }
                }
              }
            }
          },
          "401": { "description": "账号或密码错误", "content": { "application/json": { "example": { "detail": "账号或密码错误" } } } },
          "403": { "description": "账号未激活", "content": { "application/json": { "example": { "detail": "账号未激活，请先激活" } } } }
        }
      }
    },
    "/api/user/me": {
      "get": {
        "tags": ["🔐 认证管理"],
        "summary": "获取当前用户信息",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "操作成功",
                  "data": {
                    "id": 5,
                    "account": "admin",
                    "username": "超级管理员",
                    "phone": null,
                    "email": null,
                    "role": 2,
                    "is_active": 1,
                    "department_id": null,
                    "last_login_at": "2026-05-31T09:38:20.440Z",
                    "created_at": "2026-05-31T08:20:10.622Z"
                  }
                }
              }
            }
          },
          "401": { "description": "未认证", "content": { "application/json": { "example": { "detail": "Unauthorized" } } } }
        }
      }
    },
    "/api/admin/departments": {
      "get": {
        "tags": ["🏢 部门管理"],
        "summary": "获取部门列表",
        "description": "分页列表，支持 name 模糊搜索。不需要管理员权限。",
        "security": [],
        "parameters": [
          { "name": "name", "in": "query", "required": false, "schema": { "type": "string" }, "description": "部门名称模糊搜索" },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 20 } },
          { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "部门列表",
            "content": {
              "application/json": {
                "example": {
                  "items": [
                    { "id": 1, "name": "AI Lab", "intro": "AI research", "tech_stack": "Python/ML", "manager_name": null, "sort_order": 10, "is_active": true, "created_at": "2026-05-31T08:21:00.958Z", "updated_at": "2026-05-31T08:21:00.958Z" },
                    { "id": 2, "name": "技术研发部", "intro": "负责实验室系统开发", "tech_stack": "Python/Django/React", "manager_name": "超级管理员", "sort_order": 20, "is_active": true, "created_at": "2026-05-28T11:34:59.254Z", "updated_at": "2026-05-31T08:21:00.993Z" }
                  ],
                  "count": 3
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["🏢 部门管理"],
        "summary": "创建部门",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DepartmentIn" },
              "example": { "name": "人工智能研发部", "intro": "专注AI算法研究", "tech_stack": "Python/PyTorch", "manager_id": 5, "sort_order": 1 }
            }
          }
        },
        "responses": {
          "200": {
            "description": "部门创建成功",
            "content": { "application/json": { "example": { "code": 200, "message": "部门创建成功", "data": { "id": 3, "name": "人工智能研发部", "intro": "专注AI算法研究", "tech_stack": "Python/PyTorch", "manager_name": "超级管理员", "sort_order": 1, "is_active": true, "created_at": "2026-05-31T08:31:23.998Z", "updated_at": "2026-05-31T08:31:23.998Z" } } } }
          },
          "400": { "content": { "application/json": { "example": { "detail": "部门名称「人工智能研发部」已存在" } } } },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } }
        }
      }
    },
    "/api/admin/departments/sort": {
      "put": {
        "tags": ["🏢 部门管理"],
        "summary": "批量排序部门",
        "description": "使用 Case/When 单条 SQL 批量更新排序顺序。",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "items": [{ "id": 1, "sort_order": 10 }, { "id": 2, "sort_order": 20 }] }
            }
          }
        },
        "responses": {
          "200": { "content": { "application/json": { "example": { "code": 200, "message": "已更新 2 个部门的排序", "data": null } } } },
          "400": { "content": { "application/json": { "example": { "detail": "部门 ID=99 不存在" } } } },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } }
        }
      }
    },
    "/api/admin/departments/{department_id}": {
      "put": {
        "tags": ["🏢 部门管理"],
        "summary": "更新部门",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "department_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DepartmentIn" },
              "example": { "name": "AI Lab(更新)", "intro": "更新后的介绍", "tech_stack": "Python/Django/Vue", "manager_id": 5, "sort_order": 1 }
            }
          }
        },
        "responses": {
          "200": { "content": { "application/json": { "example": { "code": 200, "message": "部门更新成功", "data": { "id": 1, "name": "AI Lab(更新)", "intro": "更新后的介绍", "tech_stack": "Python/Django/Vue", "manager_name": "超级管理员", "sort_order": 1, "is_active": true, "created_at": "2026-05-28T11:34:59.254Z", "updated_at": "2026-05-31T08:21:00.993Z" } } } } },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } },
          "404": { "content": { "application/json": { "example": { "detail": "部门不存在" } } } }
        }
      },
      "delete": {
        "tags": ["🏢 部门管理"],
        "summary": "删除部门（软删除）",
        "description": "校验未处理报名记录，有则拒绝删除。",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "department_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "content": { "application/json": { "example": { "code": 200, "message": "部门已删除", "data": null } } } },
          "400": { "content": { "application/json": { "example": { "detail": "该部门下存在未处理的报名记录，无法删除" } } } },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } },
          "404": { "content": { "application/json": { "example": { "detail": "部门不存在" } } } }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "tags": ["👤 用户管理"],
        "summary": "获取用户列表",
        "description": "分页，支持学院/专业/关键词/状态筛选。",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "academy", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "major", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "search", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "is_active", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "用户列表",
            "content": {
              "application/json": {
                "example": {
                  "items": [
                    { "id": 1, "account": "2024001", "username": "张三", "phone": "13800138000", "email": "zhangsan@test.com", "department_name": "AI Lab", "is_active": 1, "role": 1, "academy": null, "major": null, "class_name": null, "created_at": "2026-05-24T11:05:00.837Z", "last_login_at": null }
                  ],
                  "count": 3
                }
              }
            }
          },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } }
        }
      }
    },
    "/api/admin/users/{user_id}/ban": {
      "put": {
        "tags": ["👤 用户管理"],
        "summary": "封禁/解封用户",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "user_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "is_banned": true, "reason": "违规操作" }
            }
          }
        },
        "responses": {
          "200": { "content": { "application/json": { "example": { "code": 200, "message": "用户 张三 已封禁", "data": { "id": 1, "account": "2024001", "username": "张三", "phone": "13800138000", "email": "zhangsan@test.com", "department_name": "AI Lab", "is_active": 0, "role": 1, "academy": null, "major": null, "class_name": null, "created_at": "2026-05-24T11:05:00.837Z", "last_login_at": null } } } } },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } },
          "404": { "content": { "application/json": { "example": { "detail": "用户不存在" } } } }
        }
      }
    },
    "/api/admin/users/export": {
      "get": {
        "tags": ["👤 用户管理"],
        "summary": "导出用户 Excel",
        "description": "下载 xlsx 文件（openpyxl + iterator 分块）。",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Excel 文件下载", "content": { "application/octet-stream": {} } },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } }
        }
      }
    },
    "/api/admin/applications": {
      "get": {
        "tags": ["📋 报名管理"],
        "summary": "获取报名列表",
        "description": "支持按部门、状态、学院、专业、时间范围复杂筛选。使用 select_related 防 N+1。",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "department_id", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "academy", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "major", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "search", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "date_from", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "date_to", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "报名列表",
            "content": {
              "application/json": {
                "example": {
                  "items": [
                    { "id": 1, "name": "张三", "status": 2, "status_display": "已通过", "audit_time": "2026-05-31T08:24:49.036Z", "audit_remark": "审核通过，欢迎加入", "class_name": "CS2101", "academy": "计算机学院", "major": "计算机科学", "email": "zhangsan@test.com", "director_name": null, "sign_reason": "对AI方向感兴趣", "department_name": "AI Lab", "department_id": 2, "user_id": 1, "user_account": "2024001", "user_username": "张三", "created_at": "2026-05-31T08:24:42.911Z" }
                  ],
                  "count": 2
                }
              }
            }
          },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } }
        }
      }
    },
    "/api/admin/applications/{application_id}/audit": {
      "put": {
        "tags": ["📋 报名管理"],
        "summary": "单条审核报名",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "application_id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "status": "approved", "remark": "审核通过，欢迎加入实验室！" }
            }
          }
        },
        "responses": {
          "200": { "content": { "application/json": { "example": { "code": 200, "message": "报名记录已通过", "data": { "id": 1, "name": "张三", "status": 2, "status_display": "已通过", "audit_remark": "审核通过，欢迎加入实验室！", "department_name": "AI Lab", "user_username": "张三" } } } } },
          "400": { "content": { "application/json": { "example": { "detail": "该报名记录已审核，无法重复审核" } } } },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } },
          "404": { "content": { "application/json": { "example": { "detail": "报名记录不存在" } } } }
        }
      }
    },
    "/api/admin/applications/batch-audit": {
      "post": {
        "tags": ["📋 报名管理"],
        "summary": "批量审核报名",
        "description": "事务 + select_for_update() 行级锁防止并发。",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "ids": [1, 2, 3], "status": "approved", "remark": "审核通过，欢迎加入实验室！" }
            }
          }
        },
        "responses": {
          "200": { "content": { "application/json": { "example": { "code": 200, "message": "成功审核 3 条报名记录", "data": null } } } },
          "400": { "content": { "application/json": { "example": { "detail": "包含无效或已审核的报名记录" } } } },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } }
        }
      }
    },
    "/api/admin/statistics/overview": {
      "get": {
        "tags": ["📊 数据统计"],
        "summary": "核心指标",
        "description": "总报名数、通过数、待审核数、今日新增、各部门统计。结果缓存 5 分钟。",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "统计概览",
            "content": {
              "application/json": {
                "example": { "total_applications": 86, "approved_count": 42, "pending_count": 23, "today_new_count": 5, "department_stats": [{ "department_name": "AI Lab", "count": 35 }, { "department_name": "技术研发部", "count": 28 }] }
              }
            }
          },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } }
        }
      }
    },
    "/api/admin/statistics/trend": {
      "get": {
        "tags": ["📊 数据统计"],
        "summary": "近 30 天报名趋势",
        "description": "按天聚合，缺失日期自动补 0（30 条）。",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "趋势数据（前 3 条示例）",
            "content": {
              "application/json": {
                "example": [
                  { "date": "2026-05-02", "count": 0 },
                  { "date": "2026-05-03", "count": 5 },
                  { "date": "2026-05-04", "count": 3 }
                ]
              }
            }
          },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } }
        }
      }
    },
    "/api/admin/statistics/departments": {
      "get": {
        "tags": ["📊 数据统计"],
        "summary": "部门报名热度排行",
        "description": "按报名数降序排列。",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "部门排行",
            "content": {
              "application/json": {
                "example": [
                  { "department_name": "AI Lab", "count": 35 },
                  { "department_name": "技术研发部", "count": 28 }
                ]
              }
            }
          },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } }
        }
      }
    },
    "/api/admin/statistics/sources": {
      "get": {
        "tags": ["📊 数据统计"],
        "summary": "生源专业分布",
        "description": "按专业 Group By 统计报名人数。",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "专业分布",
            "content": {
              "application/json": {
                "example": [
                  { "major": "计算机科学", "count": 30 },
                  { "major": "软件工程", "count": 22 },
                  { "major": "人工智能", "count": 15 }
                ]
              }
            }
          },
          "403": { "content": { "application/json": { "example": { "detail": "非管理员" } } } }
        }
      }
    },
    "/api/admin/roles": {
      "get": {
        "tags": ["🔑 角色管理"],
        "summary": "获取角色列表",
        "description": "包含关联的权限 ID 集合。",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "角色列表",
            "content": {
              "application/json": {
                "example": [
                  { "id": 1, "name": "超管", "code": "super_admin", "description": "超级管理员，拥有系统所有权限", "permission_ids": [1, 2, 3, 4, 5, 6, 7, 8], "created_at": "2026-05-31T09:05:30.093Z", "updated_at": "2026-05-31T09:05:30.093Z" },
                  { "id": 2, "name": "管理员", "code": "admin", "description": "普通管理员", "permission_ids": [2, 3, 5, 6], "created_at": "2026-05-31T09:05:30.093Z", "updated_at": "2026-05-31T09:05:30.093Z" }
                ]
              }
            }
          },
          "403": { "content": { "application/json": { "example": { "detail": "权限不足" } } } }
        }
      },
      "post": {
        "tags": ["🔑 角色管理"],
        "summary": "创建角色",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "name": "实习管理员", "code": "intern", "description": "实习管理员，有限权限", "permission_ids": [2, 3] }
            }
          }
        },
        "responses": {
          "200": { "content": { "application/json": { "example": { "code": 200, "message": "角色创建成功", "data": { "id": 5, "name": "实习管理员", "code": "intern", "description": "实习管理员，有限权限", "permission_ids": [2, 3], "created_at": "2026-05-31T10:00:00.000Z", "updated_at": "2026-05-31T10:00:00.000Z" } } } } },
          "400": { "content": { "application/json": { "example": { "detail": "角色编码「intern」已存在" } } } },
          "403": { "content": { "application/json": { "example": { "detail": "权限不足" } } } }
        }
      }
    },
    "/api/admin/roles/{role_id}": {
      "put": {
        "tags": ["🔑 角色管理"],
        "summary": "更新角色",
